# kanshi — the Wayland replacement for autorandr's automatic profile switching.
# Migrated from ~/.config/autorandr/{office,home,mesnil,mobile}
#
# THREE DIFFERENCES FROM autorandr THAT MATTER:
#
# 1. POSITIONS ARE LOGICAL, NOT PHYSICAL PIXELS.
#    autorandr positions are raw pixels. kanshi/sway positions are in scaled
#    logical pixels. eDP-1 at scale 1.5 is 1280x800 logically, not 1920x1200,
#    so every position involving it had to be recomputed. Your autorandr
#    profiles consistently centred the laptop under the external (office had
#    eDP at x=760 = (3440-1920)/2), so that intent is preserved below using
#    logical widths.
#
# 2. DO NOT LIST DISCONNECTED OUTPUTS.
#    autorandr lists `output DP-4 / off` harmlessly. kanshi only applies a
#    profile when every output it names is actually connected, so listing
#    absent outputs would stop the profile matching at all. All the `off`
#    entries are therefore dropped rather than translated.
#
# 3. ORDER MATTERS — FIRST MATCH WINS.
#    `mobile` names only eDP-1, which is connected in every situation, so it
#    must come LAST or it would shadow every docked profile.

# --- office: Lenovo ultrawide + laptop underneath -------------------------
# autorandr: DP-1 3440x1440 @0x0, eDP-1 1920x1200 @760x1440
# eDP-1 -> 161 DPI -> scale 1.5 -> logical 1280x800
# centred under the ultrawide: (3440-1280)/2 = 1080
profile office {
    output DP-1  mode 3440x1440@59.97Hz position 0,0       scale 1
    output eDP-1 mode 1920x1200@60Hz    position 1080,1440 scale 1.5
}

# --- home: AOC 24" 1080p above, laptop below -----------------------------
# autorandr: HDMI-1 1920x1080 @0x0, eDP-1 1920x1200 @0x1080
# The old x=0 was already centring (both panels were 1920 wide). With eDP
# scaled to 1280 logical, centring is now (1920-1280)/2 = 320.
# AOC 24B1W1 is ~92 DPI, so scale 1 is correct for it.
profile home {
    output "AOC 24B1W1 NHTL1BA004888" mode 1920x1080@60Hz position 0,0      scale 1
    output eDP-1                      mode 1920x1200@60Hz position 320,1080 scale 1.5
}

# --- mesnil: AOC 27" 1080p to the right of the laptop --------------------
# autorandr: eDP-1 1920x1080 @0x766, HDMI-1 1920x1080 @1920x0
#
# NOTE: this profile was recorded on a DIFFERENT LAPTOP. Its stored eDP-1
# EDID is a CMN N140HCR-GL2 (1920x1080); your current panel is a BOE
# NV140WUM-T07 (1920x1200). The old profile could therefore never match this
# machine. Rebuilt here for the current panel: eDP-1 logical 1280x800 on the
# left, external to its right at x=1280, bottom-aligned (1080-800 = 280).
profile mesnil {
    output eDP-1              mode 1920x1200@60Hz position 0,280   scale 1.5
    output "AOC 27V2G5 Unknown" mode 1920x1080@60Hz position 1280,0 scale 1
}

# --- mobile: laptop alone (MUST BE LAST, see note 3) ---------------------
profile mobile {
    output eDP-1 mode 1920x1200@60Hz position 0,0 scale 1.5
}

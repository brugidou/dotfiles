[user]
	name = m.brugidou
	email = m.brugidou@criteo.com
[color]
    diff = auto
	status = true
[push]
	default = simple
[core]
	hooksPath = /home/m.brugidou/.git_hooks/
[alias]
	review = "!f() { git push origin HEAD:refs/for/master%$1; }; f"
	draft = "!f() { git push origin HEAD:refs/for/master%wip,$1; }; f"
	l = log --pretty=format:\"%C(yellow)%h\\\\ %ad%Cred%d\\\\ %Creset%s%Cblue\\\\ [%cn]\" --decorate --date=short
	ll = log --pretty=format:\"%C(yellow)%h%Cred%d\\\\ %Creset%s%Cblue\\\\ [%cn]\" --decorate --numstat
	lll = log -u
	diffc = diff --cached HEAD^
	ca = commit --amend --no-edit --reset-author
	amend-blind = "!git add -u ; git ca ; git review"
	ch = checkout
	st = status
	hard = reset --hard origin/master
[url "gerrit:"]
	insteadOf = https://review.crto.in/a/
